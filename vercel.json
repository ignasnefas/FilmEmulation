{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/web"
      }
    }
  ],
  "routes": [
    {
      "src": "(.*\\.(js|css|svg|png|jpg|jpeg|webp|ico|json|map|wasm|txt))",
      "dest": "/$1"
    },
    {
      "src": "(.*)",
      "dest": "/index.html"
    }
  ]
}
